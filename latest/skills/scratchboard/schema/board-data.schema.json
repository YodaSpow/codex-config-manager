{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scratchboard day state",
  "type": "object",
  "required": ["schemaVersion", "date", "state", "createdAtUtc", "updatedAtUtc", "blocks"],
  "properties": {
    "schemaVersion": {"const": 1}, "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "state": {"enum": ["active", "frozen"]}, "createdAtUtc": {"type": "string"}, "updatedAtUtc": {"type": "string"},
    "blocks": {"type": "array", "items": {"type": "object", "required": ["id", "capturedAtUtc", "captureSequence", "type", "markdown"]}}
  }
}
